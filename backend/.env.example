# ==============================================================================
# UniFlow X Backend Environment Configuration
# Copy this file to .env for local development override
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="UniFlow X API"
API_V1_STR=/api/v1
SECRET_KEY=dev_secret_key_change_in_production_89429184912

# Database Connection (MySQL / MariaDB)
MYSQL_USER=uniflow_user
MYSQL_PASSWORD=uniflow_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=uniflow_x

# Full Database Connection String (SQLAlchemy PyMySQL Driver)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://uniflow_user:uniflow_password@localhost:3306/uniflow_x

# CORS Origins (JSON array or comma-separated URLs)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]
