# FastAPI Backend Environment Variables Example
PROJECT_NAME="UniFlow X API"
API_V1_STR="/api/v1"
SECRET_KEY="your-super-secret-key-change-this-in-production"

# MySQL Database Configuration
MYSQL_SERVER="localhost"
MYSQL_USER="root"
MYSQL_PASSWORD="password"
MYSQL_DB="uniflow_x"
MYSQL_PORT=3306
DATABASE_URL="mysql+pymysql://root:password@localhost:3306/uniflow_x"
