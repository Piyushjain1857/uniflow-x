{
  "expo": {
    "name": "UniFlow X",
    "slug": "uniflow-x",
    "version": "1.0.0",
    "scheme": "uniflowx",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "jsEngine": "jsc",
    "splash": {
      "backgroundColor": "#0b0f19"
    },
    "plugins": [
      "expo-router"
    ],
    "router": {
      "appRoot": "./app"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "jsEngine": "jsc"
    },
    "android": {
      "backgroundColor": "#0b0f19",
      "jsEngine": "jsc"
    }
  }
}
